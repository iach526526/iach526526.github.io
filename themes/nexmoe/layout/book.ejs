<section class="nexmoe-bookshelf">
  <h1 style="color: #eee;">📚 我的書架</h1>
  
  <% 
  // 篩選書本頁面
  let bookk = site.pages
    .filter(p => p.source.startsWith('bookshelf/') && p.source.endsWith('.md') && p.source !== 'bookshelf/index.md')
    .toArray();
  
  // 依年份降冪排序
  let sortedPages = bookk.sort((a, b) => {
    const yearA = parseInt(a.source.split('/')[1]) || 0;
    const yearB = parseInt(b.source.split('/')[1]) || 0;
    return yearB - yearA;
  });
  
  // 將頁面依年份分組 (key: 年份, value: 該年書本陣列)
  let groupedByYear = {};
  sortedPages.forEach(page => {
    const year = page.source.split('/')[1] || '未知年份';
    if (!groupedByYear[year]) {
      groupedByYear[year] = [];
    }
    groupedByYear[year].push(page);
  });
  %>

  <% Object.keys(groupedByYear).sort((a,b) => b - a).forEach(year => { %>
    <h2 style="width: 100%; color: #ffcc00; margin: 2rem 0 1rem 0;"><%= year %></h2>
    <div class="book-list" style="display: flex; flex-wrap: wrap; gap: 1rem;">
      <% groupedByYear[year].forEach(page => { %>
        <div class="book-item" style="width: 150px; text-align: center;">
          <a href="<%- url_for(page.path) %>">
            <% if (page.cover) { %>
              <img src="<%- page.cover %>" alt="<%= page.title %>" style="width: 100%; height: auto; border-radius: 8px;">
            <% } else { %>
              <div style="width: 100%; height: 200px; background: #b02020; display: flex; align-items: center; justify-content: center;">
                <span style="color: #eee;"><%= page.title %></span>
              </div>
            <% } %>
          </a>
          <h3 style="margin-top: 0.5rem; font-size: 1rem; color: #eee;"><%= page.title %></h3>
        </div>
      <% }) %>
    </div>
  <% }) %>
</section>
