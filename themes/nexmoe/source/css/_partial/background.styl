#nexmoe-background {
    .nexmoe-bg {
        opacity: 0.2;
        background-size: cover;
        filter: blur(30px);
        height: 100vh;
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: -1;
    }

    .mdui-appbar {
        padding: 10px;
        display: none;

        img {
            width: 100%;
        }
    }
}
@media screen and (max-width: 1023px) {
    #nexmoe-background {
        .mdui-appbar {
            display: block !important;
        }
    }
}
.quick-links{
  padding: 10px 12px;
  align-items: center;
  background: #1609350a
}

.quick-btn{
  display: inline-flex;
  align-items: center;        
  justify-content: space-between;
  padding: 8px 10px;
  border-radius: 10px;
  text-decoration: none;
  color: var(--color-text-2);
  background: transparent !important;
  min-width: 0;
  max-height: none;
  font-size: 1rem;
  line-height: 1;
  white-space: nowrap;
}
.quick-search{
  flex: 1 1 240px;
  min-width: 160px;
  margin: 0;
}

/* 搜尋框本體 */
.quick-search-input{
  width: 100%;
  height: 40px;
  padding: 0 12px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,.25);
  background: rgba(0,0,0,.25);
  color: #fff;
  font-size: 14px;
  outline: none;
}

.quick-search-input::placeholder{
  color: rgba(255,255,255,.7);
}

.quick-search-input:focus{
  border-color: rgba(255,255,255,.5);
  background: rgba(0,0,0,.35);
}

@media screen and (max-width: 800px){
  .quick-links{
    align-items: stretch;
    gap: 8px;
  }

  .quick-btn{
    justify-content: flex-start;
    padding-left: 14px;
  }

  .quick-search{
    flex: none;
    width: 100%;
  }

  .quick-search-input{
    height: 44px;
    font-size: 15px;
  }

}