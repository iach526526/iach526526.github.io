#nexmoe-background {
    .nexmoe-bg {
        opacity: 0.2;
        background-size: cover;
        filter: blur(30px);
        height: 100vh;
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: -1;
    }

    .mdui-appbar {
        padding: 10px;
        display: none;

        img {
            width: 100%;
        }
    }
}
@media screen and (max-width: 1023px) {
    #nexmoe-background {
        .mdui-appbar {
            display: block !important;
        }
    }
}.top-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 12px;
}

.card {
  background: #f8f8f8ff;
  border-radius: 16px;
  padding: 12px;
  color: #202020ff;
  min-height: 120px;
}

/* 快速連結 */
.quick-links {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
.quick-btn {
  display: flex;
    align-items: flex-end;   /* 垂直靠下 */
  justify-content: flex-start; /* 水平靠左 */
  padding: 10px;
  border-radius: 12px;
  text-decoration: none;
  color: #212121ff;
  font-size: 14px;
  transition: background 0.3s;
}
.quick-btn:nth-child(odd) {
  background: linear-gradient(0.25turn, #7ac2e1ff,  #3cf674ff);
}

.quick-btn:nth-child(even) {
 background: linear-gradient(0.25turn, #3cf674ff,  #f6b53cff);
}

.quick-btn:hover {
  background: #d2bd23ff;
}

/* 名片樣式 */
.profile-card {
    position: relative;
    padding-left: 89px; /* 頭像佔位 */
    min-height: 80px;
}

.profile-avatar {
    position: absolute;
    top: 16px;
    left: 16px;
    display: block;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    margin-right:50px
}

.profile-name {
  font-size: 16px;
  font-weight: bold;
  margin: 0 0 4px;
}
.profile-desc {
  font-size: 13px;
  margin: 0 0 8px;
}
.profile-icons {
  display: flex;
  gap: 10px;
}
.profile-icons a {
  font-size: 18px;
  text-decoration: none;
}
.profile-action {
  position: absolute;
  bottom: 12px;
  right: 12px;
  font-size: 20px;
}
